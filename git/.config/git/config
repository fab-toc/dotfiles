[user]
  name = fab-toc
  email = 81991643+fab-toc@users.noreply.github.com
  signingkey = ~/.ssh/github_signing_key.pub

[core]
  compression = 9
  whitespace = error
  preloadindex = true
  editor = code --wait

[help]
  autocorrect = prompt

[init]
  defaultBranch = main

[status]
  branch = true
  showStash = true
  showUntrackedFiles = all

[branch]
  sort = -committerdate

[diff]
  algorithm = histogram
  colorMoved = plain
  mnemonicPrefix = true
  renames = true
  context = 3
  interHunkContext = 10

# [advice]
#   addEmptyPathspec = false

[column]
  ui = auto

[pager]
  diff = diff-so-fancy | $PAGER

[interactive]
  diffFilter = diff-so-fancy --patch
  singlekey = true

[fetch]
  prune = true
  pruneTags = true
  all = true

[push]
  default = current
  autoSetupRemote = true
  followTags = true

[pull]
  default = current
  rebase = true

[rebase]
  autoStash = true
  autoSquash = true
  updateRefs = true
  missingCommitsCheck = warn

[log]
  abbrevCommit = true

[gpg]
  format = ssh

[commit]
  gpgsign = true

[tag]
  sort = version:refname
  gpgsign = true

# Third-party: diff-so-fancy
[diff-so-fancy]
  markEmptyLines = false


# URL shortcuts
[url "git@github.com:"]
  insteadOf = "gh:"

[url "git@github.com:fab-toc/"]
  insteadOf = "ft:"

[url "git@github.com:info-telecom-strasbourg/"]
  insteadOf = "its:"
