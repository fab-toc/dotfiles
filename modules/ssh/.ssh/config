# Defaults only. This repository is public, so it contains no key material and
# no host inventory: hostnames, internal addresses and ports describe real
# infrastructure and belong in an untracked local config.
# See docs/adr/0004-manual-ssh-key-retrieval.md
#
# ~/.ssh is one of the few places that does not honour the XDG spec, so it is
# left where OpenSSH expects it.

# First obtained value wins in ssh_config, so the local file is included first:
# its host-specific settings must be read before the Host * defaults below.
# Create it by hand — see docs/setup/openssh.md
Include ~/.ssh/config.local

# github.com is a public host, so its entry belongs here rather than in the
# local config. It must exist: IdentitiesOnly below means ssh offers only the
# keys named in the configuration, so a host with no IdentityFile falls back to
# the default id_* filenames and fails to authenticate even when the right key
# is already loaded in the agent.
Host github.com
  User git
  IdentityFile ~/.ssh/github_key

Host *
  # Load a key into the running agent the first time it is used. Nothing in
  # this repository starts an agent; the session's own is used.
  AddKeysToAgent yes
  # Offer only the key named for a host, not every key on disk. Without this,
  # more than one key means servers reject you for too many failed attempts
  # before the right key is ever tried.
  IdentitiesOnly yes
  HashKnownHosts yes
  ServerAliveInterval 60
  ServerAliveCountMax 3
  SetEnv TERM=xterm-256color
