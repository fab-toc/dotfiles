# Identity and signing key live outside this public repository, in an
# untracked config.local. Git ignores this include when the file is absent.
# See docs/adr/0004-manual-ssh-key-retrieval.md
[include]
  path = config.local

[help]
  autoCorrect = immediate  # run the suggested correction command immediately

[core]
  compression = 9
  preloadIndex = true
  # fsmonitor = true
  # untrackedCache = true

[init]
  defaultBranch = main

[branch]
  sort = -committerdate

[diff]
  algorithm = histogram
  mnemonicPrefix = true
  renames = copies
  context = 3
  interHunkContext = 10
  wsErrorHighlight = all

[status]
  branch = true
  # short = true
  showStash = true
  showUntrackedFiles = all

[log]
  abbrevCommit = true
  # graphColors  = blue,yellow,cyan,magenta,green,red

[commit]
  gpgSign = true
  verbose = true

[tag]
  sort = version:refname
  gpgSign = true

[merge]
  conflictStyle = zdiff3  # show all versions in conflicts

[rerere]
  enabled = true
  autoUpdate = true

[rebase]
  autoStash = true
  autoSquash = true
  updateRefs = true
  missingCommitsCheck = warn


# ===========================
# Integrity & Fetching
# ===========================
[transfer]
  fsckObjects = true

[receive]
  fsckObjects = true

[fetch]
  all = true
  prune = true
  pruneTags = true
  fsckObjects = true

[push]
  autoSetupRemote = true
  default = current
  followTags = true
  gpgSign = true

[pull]
  default = current
  # rebase = true

[gpg]
  format = ssh


# No pager is configured here on purpose. Git configuration cannot test
# whether a binary exists — includeIf supports only gitdir:, onbranch: and
# hasconfig: — so an external pager named here breaks `git diff` outright on
# any machine lacking it. See docs/adr/0003-no-zsh-plugin-manager.md
[interactive]
  singleKey = true

[column]
  ui = auto


# ===========================
# URL shortcuts
# ===========================
[url "git@github.com:"]
  insteadOf = "gh:"

[url "git@github.com:fab-toc/"]
  insteadOf = "ft:"

[url "git@github.com:info-telecom-strasbourg/"]
  insteadOf = "its:"
