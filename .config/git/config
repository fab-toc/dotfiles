[user]
  name = fab-toc
  email = 81991643+fab-toc@users.noreply.github.com
  signingkey = ~/.ssh/github_signing_key.pub

[core]
  compression = 9
  preloadindex = true

[init]
  defaultBranch = main

[status]
  showStash = true

[push]
  autoSetupRemote = true
  default = current

[pull]
  default = current

[log]
  abbrevCommit = true

[diff]
  context = 3
  renames = copies
  interHunkContext = 10

[pager]
  diff = diff-so-fancy | $PAGER

[interactive]
  diffFilter = diff-so-fancy --patch
  singlekey = true

[diff-so-fancy]
  markEmptyLines = false

[gpg]
  format = ssh

[commit]
  gpgsign = true

[tag]
  gpgsign = true

[url "git@github.com:"]
  insteadOf = "gh:"

[url "git@github.com:fab-toc/"]
  insteadOf = "me:"

[url "git@github.com:info-telecom-strasbourg/"]
  insteadOf = "its:"